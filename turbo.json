{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_CONVEX_URL", "CONVEX_URL", "VITE_AUTH0_DOMAIN", "VITE_AUTH0_CLIENT_ID"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env.local", "$TURBO_ROOT$/.env"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    }
  }
}
