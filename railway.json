{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bun install --frozen-lockfile && bun run build",
    "watchPatterns": ["/apps/web/**", "/packages/**", "/package.json", "/bun.lock", "/turbo.json", "/railway.json"]
  },
  "deploy": {
    "startCommand": "bunx --yes serve -s apps/web/dist -l tcp://0.0.0.0:$PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
